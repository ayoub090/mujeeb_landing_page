# Copy to .env on the VPS. Never commit the populated file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
ANALYTICS_ADMIN_KEY=replace-with-a-long-random-value
ACQUISITION_ADMIN_KEY=replace-with-a-different-long-random-value
ACQUISITION_DAILY_LIMIT=30
ACQUISITION_AUTO_SEND_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OLLAMA_MODEL=qwen2.5:3b
INTERNAL_ADMIN_EMAIL=admin@your-company.example

# Public domains and TLS contact
PRIMARY_DOMAIN=usemujeeb.com
APP_DOMAIN=app.usemujeeb.com
API_DOMAIN=api.usemujeeb.com
ACME_EMAIL=ops@your-company.example

# WhatsApp provider and verification
