        "jsCode": "const data = $json;\nif (!data.company || !data.website) return [];\nreturn [{ json: {\n  company: String(data.company).slice(0,180),\n  website: data.website,\n  source_url: data.source_url || data.website,\n  country_code: data.country_code || null,\n  platform: data.platform || 'other',\n  public_email: data.public_email || null,\n  public_phone: data.public_phone || null,\n  social_profiles: data.social_profiles || {},\n  evidence: data.evidence || {},\n  message_draft: null\n} }];"
