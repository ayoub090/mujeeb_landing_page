        "jsCode": "const body = $json.body || $json;\nconst urls = Array.isArray(body.urls) ? body.urls : [];\nif (!urls.length) throw new Error('Provide at least one public ecommerce URL');\nif (urls.length > 30) throw new Error('Safety limit: maximum 30 URLs per run');\nconst runId = body.run_id || `mujeeb-${Date.now()}`;\nreturn [...new Set(urls)].map(url => ({ json: { url, country_hint: body.country_hint || null, run_id: runId } }));"
      },
