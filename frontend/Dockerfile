FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL
ARG VITE_META_APP_ID
ARG VITE_META_CONFIG_ID
ARG VITE_META_GRAPH_VERSION=v23.0
ENV VITE_API_URL=$VITE_API_URL VITE_META_APP_ID=$VITE_META_APP_ID VITE_META_CONFIG_ID=$VITE_META_CONFIG_ID VITE_META_GRAPH_VERSION=$VITE_META_GRAPH_VERSION
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
